# 로컬-우선: 키 없어도 부팅. 라이브 검증 시 채움.

# --- 프로바이더 키 ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=            # 텍스트 Gemini + Nano Banana(M4 이미지 생성) 공용 키

# --- 모델 (선택; 미지정 시 아래 기본값 사용) ---
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash

# --- 스토리지 / 게이트 ---
VFS_BACKEND=local         # local | supabase
JBM_STORAGE_DIR=data/runs
ENTITLEMENT_OVERRIDE=0    # 1=데모용 유료 게이트 우회 (실 PG 청구는 Non-goal)
DEMO_LATENCY_MS=0         # >0이면 mock 응답에 자연 레이턴시(기저 ms + 길이 비례, 상한 2.5s) — 데모 체감용

# 히어로 우선 벡터 크롬(spec 2026-07-02): 1이면 S2a가 텍스트프리 히어로+편집 벡터 spec 생성. 기본 0=베이크.
RICH_VECTOR_CHROME=0

# --- M6 DeployStudio advisor (D2 카피 적응) ---
# ADVISOR_MODE=auto: ANTHROPIC_API_KEY 있으면 실 LLM, 없으면 scripted fallback
# ADVISOR_MODE=live: 실 LLM 강제 (키 없으면 라우트가 422 반환)
# ADVISOR_MODE=scripted: 항상 키워드 감지 truncate (오프라인 데모용)
ADVISOR_MODE=auto
ANTHROPIC_ADVISOR_MODEL=claude-sonnet-4-6

# --- CORS (분리형 배포 시; 쉼표 구분. 미설정 시 localhost 폴백) ---
CORS_ALLOW_ORIGINS=            # 예: https://jb-marker-web.vercel.app

# --- Supabase (VFS_BACKEND=supabase 일 때 필수; Dashboard → Settings → API) ---
SUPABASE_URL=                  # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=vfs-blobs
