# 로컬-우선: 키 없어도 부팅. 라이브 검증 시 채움.

# --- 프로바이더 키 ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=            # 텍스트 Gemini + Nano Banana(M4 이미지 생성) 공용 키

# --- 모델 (선택; 미지정 시 아래 기본값 사용) ---
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-2.0-flash

# --- 스토리지 / 게이트 ---
VFS_BACKEND=local         # local | supabase(M7 예정)
JBM_STORAGE_DIR=data/runs
ENTITLEMENT_OVERRIDE=0    # 1=데모용 유료 게이트 우회 (실 PG 청구는 Non-goal)
